{
  "info": {
    "name": "ToolTown Makerspace API",
    "description": "Run on a FRESH database (npm run reset, then npm start). Run folders top to bottom with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Twist tests (automatic codes)",
      "item": [
        {
          "name": "Test 1 - Add first tool -> 201, TLS-0001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Code is TLS-0001\", () => pm.expect(pm.response.json().code).to.eql(\"TLS-0001\"));",
                  "pm.collectionVariables.set(\"tool1Id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tools"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bosch Drill\",\n  \"kind\": \"drill\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Test 2 - Add second tool -> TLS-0002",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Code is TLS-0002\", () => pm.expect(pm.response.json().code).to.eql(\"TLS-0002\"));",
                  "pm.collectionVariables.set(\"tool2Id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tools"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Makita Jigsaw\",\n  \"kind\": \"saw\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Test 3 - Update first tool with a new code -> 200, code unchanged",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Code is still TLS-0001\", () => pm.expect(pm.response.json().code).to.eql(\"TLS-0001\"));",
                  "pm.test(\"Name was updated\", () => pm.expect(pm.response.json().name).to.eql(\"Bosch Drill Pro\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tools/{{tool1Id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tools",
                "{{tool1Id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bosch Drill Pro\",\n  \"kind\": \"drill\",\n  \"code\": \"HACK-9999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Client cannot set code on create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Server ignored client code -> TLS-0003\", () => pm.expect(pm.response.json().code).to.eql(\"TLS-0003\"));",
                  "pm.collectionVariables.set(\"tool3Id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tools"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hand Sander\",\n  \"kind\": \"sander\",\n  \"code\": \"TLS-9999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
